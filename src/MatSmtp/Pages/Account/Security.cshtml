@page
@model MatSmtp.Pages.Account.SecurityModel
@{
    ViewData["Width"] = "narrow";
}

@if (Model.RequiredButMissing)
{
    <div class="mat-alert mat-alert--warning">@Ui.Icon("alert")<div class="mat-alert__body"><strong>Für Administratoren ist der zweite Faktor Pflicht.</strong> Richte ihn jetzt ein, um weiterzuarbeiten.</div></div>
}

@if (Model.RecoveryCodes is not null)
{
    <ms-card title="Wiederherstellungscodes" icon="key">
        <div class="mat-alert mat-alert--warning">@Ui.Icon("alert")<div class="mat-alert__body">Speichere diese Codes jetzt an einem sicheren Ort. Sie werden nur einmal angezeigt. Jeder Code gilt einmal, falls du dein Handy nicht hast.</div></div>
        <ul class="ms-codes" id="recovery-codes">
            @foreach (var code in Model.RecoveryCodes)
            {
                <li class="mat-mono">@code</li>
            }
        </ul>
        <div class="mat-btn-row mat-btn-row--plain">
            <button type="button" class="mat-btn mat-btn--secondary" data-copy="#recovery-codes">@Ui.Icon("copy")<span>Alle kopieren</span></button>
        </div>
    </ms-card>
}

<ms-card title="Zweiter Faktor (Authenticator-App)" icon="shield">
    @if (Model.Enabled)
    {
        <p><span class="ms-chip ms-chip--ok">Aktiv</span> Beim Anmelden fragen wir zusätzlich nach dem Code deiner App. Noch <strong>@Model.RemainingCodes</strong> Wiederherstellungscodes übrig.</p>
        <form class="mat-form" method="post" novalidate>
            <ms-input name="Confirm" label="Zur Bestätigung: dein Passwort (oder ein Code)" type="password" autocomplete="current-password" required="true" />
            <div class="mat-btn-row">
                <button type="submit" asp-page-handler="NewCodes" class="mat-btn mat-btn--secondary">@Ui.Icon("refresh")<span>Neue Wiederherstellungscodes</span></button>
                <span class="mat-btn-row__spacer"></span>
                <button type="submit" asp-page-handler="Disable" class="mat-btn mat-btn--danger" data-confirm="Den zweiten Faktor wirklich entfernen? Dein Konto ist dann nur noch mit dem Passwort geschützt." data-confirm-ok="Entfernen">@Ui.Icon("trash")<span>Entfernen</span></button>
            </div>
        </form>
    }
    else if (Model.Enrollment is not null)
    {
        <ol class="ms-steps">
            <li>Öffne eine Authenticator-App (zum Beispiel Aegis, Google Authenticator oder Microsoft Authenticator).</li>
            <li>Scanne diesen QR-Code oder gib den Schlüssel von Hand ein.</li>
            <li>Gib den sechsstelligen Code aus der App ein.</li>
        </ol>
        <div class="ms-qr">@Html.Raw(Model.Enrollment.QrSvg)</div>
        <p class="mat-hint">Schlüssel: <span class="mat-mono">@Model.Enrollment.Secret</span></p>
        <form class="mat-form" method="post" asp-page-handler="Confirm" novalidate>
            <ms-input name="Code" label="Code aus der App" type="text" inputmode="numeric" autocomplete="one-time-code" required="true" />
            <div class="mat-btn-row">
                <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("check")<span>Bestätigen und aktivieren</span></button>
                <a class="mat-btn mat-btn--secondary" href="/Account/Security">@Ui.Icon("back")<span>Abbrechen</span></a>
            </div>
        </form>
    }
    else
    {
        <p class="mat-muted">Mit einer Authenticator-App schützt du dein Konto doppelt: Zum Passwort kommt ein Code, der sich alle 30 Sekunden ändert.</p>
        <form method="post" asp-page-handler="Begin">
            <div class="mat-btn-row">
                <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("shield")<span>Einrichten</span></button>
            </div>
        </form>
    }
</ms-card>

<ms-card title="Angemeldete Geräte" icon="smartphone">
    <div class="mat-list">
        <div class="mat-table-wrap">
            <table class="mat-table" id="sessions">
                <caption class="mat-sr-only">Angemeldete Geräte</caption>
                <thead><tr><th scope="col">Gerät</th><th scope="col" class="mat-hide-sm">Adresse</th><th scope="col">Zuletzt aktiv</th><th scope="col"><span class="mat-sr-only">Aktionen</span></th></tr></thead>
                <tbody>
                    @foreach (var s in Model.Sessions)
                    {
                        <tr>
                            <td data-label="Gerät">@s.Device @if (s.IsThis) { <span class="ms-chip ms-chip--accent">dieses Gerät</span> }</td>
                            <td data-label="Adresse" class="mat-hide-sm mat-mono">@s.Ip</td>
                            <td data-label="Zuletzt aktiv">@Fmt.Moment(s.LastSeen)</td>
                            <td class="mat-table__cell-actions">
                                @if (!s.IsThis)
                                {
                                    <form method="post" asp-page-handler="EndSession" asp-route-id="@s.Id" class="mat-table__actions">
                                        <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" aria-label="Gerät abmelden" data-tip="Abmelden">@Ui.Icon("logout")</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Sessions.Count > 1)
        {
            <form method="post" asp-page-handler="EndOthers">
                <div class="mat-actions">
                    <button type="submit" class="mat-btn mat-btn--secondary" data-confirm="Alle anderen Geräte abmelden?" data-confirm-ok="Abmelden">@Ui.Icon("logout")<span>Alle anderen abmelden</span></button>
                </div>
            </form>
        }
    </div>
</ms-card>
